<Project Sdk="Microsoft.NET.Sdk">

  <!-- Win32/WinRT side: process memory, capture, audio, overlay, tray,
       Pin Share I/O. P/Invokes are hand-written per area with
       [LibraryImport] in an internal NativeMethods class next to their use. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>RappyRuns.Win</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RappyRuns.Core\RappyRuns.Core.csproj" />
  </ItemGroup>

</Project>
